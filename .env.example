# Chiave segreta per l'autenticazione degli slave Arduino
SENSOR_API_KEY=arduino-torino-noise-secret-2026

# Chiave per endpoint amministrativi (es. consultazione storico raw)
ADMIN_API_KEY=admin-torino-security-secret-2026

# Chiave segreta per firma cookie di sessione amministrativa (HMAC SHA-256)
ADMIN_SESSION_SECRET=genera-qui-una-stringa-segreta-lunga-e-casuale

# Credenziali primo account Superadmin (creato solo al primo avvio se tabella vuota)
INITIAL_SUPERADMIN_USER=admin
INITIAL_SUPERADMIN_PASSWORD=ScegliPasswordSicura2026!

# Percorso database SQLite
DATABASE_PATH=./noise_monitor.db

# ==========================================
# Allerte rumore persistente (Telegram + Google Maps)
# ==========================================

# Token del bot Telegram (ottenuto da @BotFather). Senza token gli invii sono saltati.
TELEGRAM_BOT_TOKEN=

# (Opzionale) Segreto condiviso per validare le chiamate del webhook Telegram
TELEGRAM_WEBHOOK_SECRET=

# API key Google Maps Platform (Places API) per verificare se un esercizio è aperto.
# Senza chiave lo stato "aperto" resta sconosciuto e l'allerta viene inviata comunque.
GOOGLE_MAPS_API_KEY=

# Canale per la verifica "esercizio aperto": manual | osm | google | off
#  - manual: usa gli orari registrati nel profilo dell'esercizio (nessuna API)
#  - osm:    legge il tag opening_hours da OpenStreetMap via Overpass (nessuna API key)
#  - google: usa Places API (New), richiede GOOGLE_MAPS_API_KEY e billing
#  - off:    salta la verifica e allerta tutti gli esercenti nel raggio
OPEN_STATUS_PROVIDER=manual

# Endpoint Overpass API usato dal provider "osm" (nessuna chiave richiesta)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Parametri dell'allerta (override opzionali; in codice esistono già i default) ---
# Soglia dB oltre la quale il rumore è "elevato" (default: 65)
NOISE_ALERT_THRESHOLD_DB=65
# Minuti di rumore continuativo sopra soglia prima dell'allerta (default: 10)
NOISE_ALERT_PERSISTENCE_MINUTES=10
# Tolleranza (minuti) di pausa sotto soglia che non azzera la violazione (default: 1)
NOISE_ALERT_QUIET_GRACE_MINUTES=1
# Minuti minimi tra due allerte per la stessa violazione (default: 10)
NOISE_ALERT_COOLDOWN_MINUTES=10
# Raggio (metri) attorno alla stazione entro cui allertare gli esercenti (default: 200)
COMPANY_ALERT_RADIUS_METERS=200
